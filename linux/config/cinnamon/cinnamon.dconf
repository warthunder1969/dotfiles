[/]
alttab-switcher-delay=100
command-history=['r']
desklet-snap-interval=25
enabled-applets=['panel1:left:0:menu@cinnamon.org:0', 'panel1:left:1:separator@cinnamon.org:1', 'panel1:right:4:systray@cinnamon.org:3', 'panel1:right:5:xapp-status@cinnamon.org:4', 'panel1:right:6:removable-drives@cinnamon.org:7', 'panel1:right:7:keyboard@cinnamon.org:8', 'panel1:right:8:network@cinnamon.org:10', 'panel1:right:9:sound@cinnamon.org:11', 'panel1:right:10:power@cinnamon.org:12', 'panel1:right:11:calendar@cinnamon.org:13', 'panel1:right:13:cornerbar@cinnamon.org:14', 'panel1:right:2:betterlock:15', 'panel1:right:1:weather@mockturtl:16', 'panel1:right:12:notifications@cinnamon.org:43', 'panel1:center:0:workspace-switcher@cinnamon.org:46', 'panel1:right:3:inhibit@cinnamon.org:50', 'panel1:left:2:grouped-window-list@cinnamon.org:55', 'panel2:right:3:calendar@cinnamon.org:56', 'panel2:right:2:weather@mockturtl:57', 'panel2:left:0:grouped-window-list@cinnamon.org:58', 'panel2:center:0:workspace-switcher@cinnamon.org:59']
enabled-desklets=['system-monitor-graph@rcassani:0:4775:150', 'system-monitor-graph@rcassani:1:4775:25', 'system-monitor-graph@rcassani:3:4775:275', 'system-monitor-graph@rcassani:4:4775:650', 'system-monitor-graph@rcassani:5:4775:400', 'system-monitor-graph@rcassani:6:4775:525']
enabled-extensions=['gTile@shuairan', 'OsdWithNumber@JosephMcc']
favorite-apps=['mintinstall.desktop', 'cinnamon-settings.desktop', 'com.notesnook.Notesnook.desktop:flatpak', 'steam.desktop', 'com.heroicgameslauncher.hgl.desktop:flatpak', 'net.lutris.Lutris.desktop', 'virtualbox.desktop', 'com.blackmagicdesign.resolve.desktop']
next-applet-id=60
next-desklet-id=7
panel-edit-mode=false
panel-launchers=['DEPRECATED']
panel-zone-icon-sizes='[{"panelId":1,"left":0,"center":0,"right":24},{"left":0,"center":0,"right":0,"panelId":2}]'
panel-zone-symbolic-icon-sizes='[{"panelId":1,"left":26,"center":0,"right":24},{"left":28,"center":28,"right":28,"panelId":2}]'
panel-zone-text-sizes='[{"panelId":1,"left":0,"center":0,"right":0},{"left":0,"center":0,"right":0,"panelId":2}]'
panels-autohide=['1:false', '2:false', '3:false']
panels-enabled=['1:0:bottom', '2:1:bottom']
panels-height=['1:40', '3:33', '2:40']
panels-hide-delay=['1:0', '2:0', '3:0']
panels-show-delay=['1:0', '2:0', '3:0']
show-media-keys-osd='small'
window-effect-speed=1

[cinnamon-session]
quit-time-delay=60

[desktop/applications/calculator]
exec='gnome-calculator'

[desktop/applications/terminal]
exec='wezterm start --cwd .'
exec-arg='--'

[desktop/input-sources]
sources=[('xkb', 'us')]

[desktop/interface]
clock-show-date=false
clock-use-24h=false
cursor-blink-time=1200
cursor-size=28
cursor-theme='Bibata-Modern-Classic'
gtk-theme='Mint-Y-Dark-Orange'
icon-theme='Mint-Y-Orange'
scaling-factor=uint32 1
text-scaling-factor=1.0

[desktop/keybindings]
custom-list=['__dummy__', 'custom0']

[desktop/keybindings/custom-keybindings/custom0]
binding=['Print']
command='flameshot gui'
name='Flameshot'

[desktop/keybindings/media-keys]
screenshot=@as []
terminal=['<Primary><Alt>t', '<Super>t']

[desktop/keybindings/wm]
switch-to-workspace-1=['<Alt>1']
switch-to-workspace-2=['<Alt>2']
switch-to-workspace-3=['<Alt>3']
switch-to-workspace-4=['<Alt>4']
switch-to-workspace-left=['<Alt>Left']
switch-to-workspace-right=['<Alt>Right']

[desktop/media-handling]
autorun-never=false
autorun-x-content-ignore=@as []
autorun-x-content-open-folder=@as []
autorun-x-content-start-app=['x-content/unix-software']

[desktop/notifications]
bottom-notifications=true
display-notifications=true
notification-duration=4

[desktop/peripherals/keyboard]
delay=uint32 500
numlock-state=true
repeat-interval=uint32 30

[desktop/peripherals/mouse]
double-click=400
drag-threshold=8
speed=0.0

[desktop/peripherals/touchpad]
speed=0.0

[desktop/screensaver]
lock-enabled=true

[desktop/sound]
event-sounds=false

[desktop/wm/preferences]
min-window-opacity=30
mouse-button-modifier='<Super>'
num-workspaces=4
theme='Mint-Y'
workspace-names=@as []

[gestures]
swipe-down-2='PUSH_TILE_DOWN::end'
swipe-down-3='TOGGLE_OVERVIEW::end'
swipe-down-4='VOLUME_DOWN::end'
swipe-left-2='PUSH_TILE_LEFT::end'
swipe-left-3='WORKSPACE_NEXT::end'
swipe-left-4='WINDOW_WORKSPACE_PREVIOUS::end'
swipe-right-2='PUSH_TILE_RIGHT::end'
swipe-right-3='WORKSPACE_PREVIOUS::end'
swipe-right-4='WINDOW_WORKSPACE_NEXT::end'
swipe-up-2='PUSH_TILE_UP::end'
swipe-up-3='TOGGLE_EXPO::end'
swipe-up-4='VOLUME_UP::end'
tap-3='MEDIA_PLAY_PAUSE::end'

[launcher]
check-frequency=300
memory-limit=2048

[muffin]
draggable-border-width=10
experimental-features=['x11-randr-fractional-scaling']
tile-maximize=true
unredirect-fullscreen-windows=true

[muffin/x11]
fractional-scale-mode='scale-up'

[settings-daemon/peripherals/keyboard]
numlock-state='on'

[settings-daemon/plugins/color]
night-light-enabled=true
night-light-temperature=uint32 3700

[settings-daemon/plugins/power]
sleep-display-ac=1800
sleep-inactive-ac-timeout=0

[theme]
name='Mint-Y-Dark-Orange'
