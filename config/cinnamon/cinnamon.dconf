[/]
alttab-switcher-delay=100
command-history=['r']
desklet-snap-interval=25
enabled-applets=['panel1:left:0:menu@cinnamon.org:0', 'panel1:left:1:separator@cinnamon.org:1', 'panel1:right:5:systray@cinnamon.org:3', 'panel1:right:7:xapp-status@cinnamon.org:4', 'panel1:right:15:notifications@cinnamon.org:5', 'panel1:right:8:removable-drives@cinnamon.org:7', 'panel1:right:9:keyboard@cinnamon.org:8', 'panel1:right:10:favorites@cinnamon.org:9', 'panel1:right:11:network@cinnamon.org:10', 'panel1:right:12:sound@cinnamon.org:11', 'panel1:right:13:power@cinnamon.org:12', 'panel1:right:14:calendar@cinnamon.org:13', 'panel1:right:16:cornerbar@cinnamon.org:14', 'panel1:right:2:weather@mockturtl:17', 'panel1:left:2:grouped-window-list@cinnamon.org:23', 'panel1:right:6:inhibit@cinnamon.org:27', 'panel1:center:0:workspace-switcher@cinnamon.org:28']
enabled-desklets=@as []
enabled-extensions=['OsdWithNumber@JosephMcc']
favorite-apps=['mintinstall.desktop', 'cinnamon-settings.desktop', 'com.notesnook.Notesnook.desktop:flatpak', 'org.wezfurlong.wezterm.desktop', 'org.gnome.Calculator.desktop']
next-applet-id=29
panel-edit-mode=false
panel-launchers=['DEPRECATED']
panel-zone-icon-sizes='[{"panelId": 1, "left": 36, "center": -1, "right": 28}, {"left": 0, "center": 0, "right": 0, "panelId": 2}]'
panel-zone-symbolic-icon-sizes='[{"panelId": 1, "left": 28, "center": 28, "right": 24}]'
panels-height=['1:45']

[desktop/a11y/applications]
screen-keyboard-enabled=true

[desktop/applications/calculator]
exec='gnome-calculator'

[desktop/applications/terminal]
exec='wezterm start --cwd .'
exec-arg='--'

[desktop/interface]
clock-use-24h=false
cursor-blink-time=1200
cursor-size=28
cursor-theme='Bibata-Modern-Classic'
gtk-theme='Mint-Y-Dark-Blue'
icon-theme='Mint-Y-Blue'
text-scaling-factor=1.0
toolkit-accessibility=true

[desktop/keybindings]
custom-list=['custom0']
looking-glass-keybinding=@as []
show-desklets=['<Shift><Super>d']

[desktop/keybindings/custom-keybindings/custom0]
binding=['<Primary>Control_R']
command='flameshot gui'
name='Flameshot'

[desktop/keybindings/custom-keybindings/custom1]
binding=['<Super>s']
command='/usr/bin/catfish'
name='File Search'

[desktop/keybindings/media-keys]
calculator=['<Super>c']
email=['<Super>m']
help=['<Super>h']
screensaver=['<Super>l', 'XF86ScreenSaver']
screenshot-clip=@as []
search=['<Super>s']
terminal=['<Super>t']
www=['<Super>b']

[desktop/keybindings/wm]
activate-window-menu=@as []
move-to-center=['<Primary><Shift>KP_Begin']
move-to-corner-ne=['<Primary><Shift>KP_Page_Up']
move-to-corner-nw=['<Primary><Shift>KP_Home']
move-to-corner-se=['<Primary><Shift>KP_Next']
move-to-corner-sw=['<Primary><Shift>KP_End']
move-to-side-n=['<Primary><Shift>KP_Up']
move-to-side-s=['<Primary><Shift>KP_Down']
move-to-side-w=['<Primary><Shift>KP_Insert']
move-to-workspace-1=['<Shift><Super>exclam']
move-to-workspace-2=['<Shift><Super>at']
move-to-workspace-3=['<Shift><Super>numbersign']
move-to-workspace-4=['<Shift><Super>dollar']
switch-to-workspace-1=['<Alt>1']
switch-to-workspace-10=['<Alt>0']
switch-to-workspace-2=['<Alt>2']
switch-to-workspace-3=['<Alt>3']
switch-to-workspace-4=['<Alt>4']
switch-to-workspace-5=['<Alt>5']
switch-to-workspace-6=['<Alt>6']
switch-to-workspace-7=['<Alt>7']
switch-to-workspace-8=['<Alt>8']
switch-to-workspace-9=['<Alt>9']
switch-to-workspace-down=['<Alt>Down']
switch-to-workspace-left=['<Alt>Left']
switch-to-workspace-right=['<Alt>Right']
switch-to-workspace-up=['<Alt>Up']

[desktop/media-handling]
autorun-never=false

[desktop/notifications]
bottom-notifications=true
notification-duration=4

[desktop/peripherals/keyboard]
delay=uint32 500
repeat-interval=uint32 30

[desktop/peripherals/mouse]
double-click=400
drag-threshold=8
speed=0.0

[desktop/peripherals/touchpad]
speed=0.0

[desktop/screensaver]
layout-group=0

[desktop/sound]
event-sounds=false

[desktop/wm/preferences]
min-window-opacity=30

[gestures]
enabled=true
pinch-percent-threshold=uint32 40
swipe-down-2='PUSH_TILE_DOWN::::end'
swipe-down-3='TOGGLE_OVERVIEW::::start'
swipe-down-4='VOLUME_DOWN::end'
swipe-left-2='PUSH_TILE_LEFT::::end'
swipe-left-3='WORKSPACE_NEXT::::start'
swipe-left-4='WINDOW_WORKSPACE_PREVIOUS::::start'
swipe-percent-threshold=uint32 60
swipe-right-2='PUSH_TILE_RIGHT::::end'
swipe-right-3='WORKSPACE_PREVIOUS::::start'
swipe-right-4='WINDOW_WORKSPACE_NEXT::::start'
swipe-up-2='PUSH_TILE_UP::::end'
swipe-up-3='TOGGLE_EXPO::::start'
swipe-up-4='VOLUME_UP::end'
tap-3='MEDIA_PLAY_PAUSE::end'

[muffin]
draggable-border-width=10
tile-maximize=true

[settings-daemon/peripherals/keyboard]
numlock-state='on'

[settings-daemon/plugins/color]
night-light-enabled=true
night-light-schedule-mode='always'
night-light-temperature=uint32 3700

[settings-daemon/plugins/power]
lid-close-ac-action='suspend'
lid-close-battery-action='suspend'
sleep-display-ac=1800
sleep-display-battery=1800
sleep-inactive-ac-timeout=0
sleep-inactive-battery-timeout=1800

[theme]
name='Mint-Y-Dark-Blue'
